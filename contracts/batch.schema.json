{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Window delivery batch v1",
  "required": [
    "schema_version",
    "batch_id",
    "windows",
    "queue_loss"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "window.schema.json"
      }
    },
    "queue_loss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "first_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "last_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "first_window_start_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "last_window_start_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      }
    }
  }
}
