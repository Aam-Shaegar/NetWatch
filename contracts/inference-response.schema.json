{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "predictions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "prediction.schema.json"
      }
    }
  }
}
