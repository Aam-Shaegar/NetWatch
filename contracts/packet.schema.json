{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sensor_id",
    "interface_id",
    "timestamp_ns",
    "src_ip",
    "dst_ip",
    "protocol",
    "src_port",
    "dst_port",
    "ip_length",
    "decode_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sensor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "interface_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "src_ip": {
      "type": "string"
    },
    "dst_ip": {
      "type": "string"
    },
    "protocol": {
      "enum": [
        "TCP",
        "UDP",
        "ICMP",
        "OTHER"
      ]
    },
    "src_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "dst_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "ip_length": {
      "type": "integer",
      "minimum": 0
    },
    "decode_status": {
      "enum": [
        "decoded",
        "non_ip",
        "unsupported_linktype",
        "truncated",
        "fragment",
        "malformed"
      ]
    }
  }
}
