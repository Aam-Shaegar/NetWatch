{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "policy_version",
    "windows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "window.schema.json"
      }
    },
    "histories": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "$ref": "window.schema.json"
        }
      }
    }
  }
}
