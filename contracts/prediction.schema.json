{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "model_id",
    "feature_set_version",
    "status",
    "score",
    "threshold"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "feature_set_version": {
      "const": "traffic-v1"
    },
    "status": {
      "enum": [
        "normal",
        "anomalous",
        "warming_up",
        "insufficient_data",
        "degraded",
        "error"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "threshold": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "probability",
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^cls-[0-9a-f]{24}$"
        },
        "label": {
          "enum": [
            "benign",
            "foreground_pause",
            "unknown",
            "insufficient_data",
            "large_upload",
            "large_response",
            "connection_surge",
            "persistent_exchange"
          ]
        },
        "probability": {}
      },
      "if": {
        "properties": {
          "label": {
            "enum": [
              "unknown",
              "insufficient_data",
              "large_upload",
              "large_response",
              "connection_surge",
              "persistent_exchange"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "probability": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "probability": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          }
        }
      }
    }
  }
}
