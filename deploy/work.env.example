# Save the configured copy outside Git with restrictive permissions.
# Use absolute paths. cert.pem, key.pem and model files must be readable by the container user 65532.
COMPOSE_PROJECT_NAME=netwatch-v1
NETWATCH_API_HOST=127.0.0.1
NETWATCH_API_PORT=8443
NETWATCH_GRPC_HOST=127.0.0.1
NETWATCH_GRPC_PORT=8444
NETWATCH_TLS_DIR=
NETWATCH_DB_NAME=netwatch
NETWATCH_DB_USER=netwatch
NETWATCH_DB_PASSWORD=
NETWATCH_DATABASE_URL=
# Optional separate credentials for a pre-provisioned migration role.
NETWATCH_MIGRATION_DATABASE_URL=
# Optional legacy HTTPS/JSON sensor token map. Managed gRPC sensors enroll separately.
NETWATCH_SENSOR_TOKENS=
NETWATCH_OPERATOR_TOKENS=
# This relative bind source is resolved next to deploy/work.yaml.
NETWATCH_MODEL_DIR=./models/temporal-r5
NETWATCH_MODEL_ID=v1-temporal-a721ab9def3befdc68c8d3c5
NETWATCH_V1_MODEL_BUNDLE=/model/bundle.json
NETWATCH_V1_MODEL_SHA256=6e768f7714c058113221ec3af9eb5fb8b167ab53ab7809b3eafb2f393139f717
NETWATCH_V1_TEMPORAL_BUNDLE=/model/temporal.json
# Legacy model settings for existing traffic-v1/v2 deployments.
NETWATCH_LEGACY_MODEL_BUNDLE=/model/bundle.json
NETWATCH_MODEL_SHA256=
NETWATCH_POLICY_VERSION=v1
# Optional comma-separated IDs of disabled rules.
NETWATCH_DISABLED_RULES=
NETWATCH_SERVICE_MODEL_ENTITIES=
NETWATCH_LOG_LEVEL=info
# Managed Linux host sensor (sensor-v1 profile). Set the protected host address and interface.
NETWATCH_CAPTURE_HOST=
NETWATCH_CAPTURE_INTERFACE=
# The legacy HTTPS/JSON sensor profile uses the same interface and the following options.
NETWATCH_CAPTURE_FILTER=
NETWATCH_CAPTURE_BUFFER_MIB=16
NETWATCH_CAPTURE_LATENESS=1s
NETWATCH_CAPTURE_SERVICE=
NETWATCH_CAPTURE_FEATURE_SET=traffic-v1
NETWATCH_CAPTURE_SENSOR=live
NETWATCH_SENSOR_ENDPOINT=
NETWATCH_SENSOR_TOKEN=
# Optional public CA certificate in PEM form for the sensor HTTPS endpoint.
NETWATCH_SENSOR_CA_PEM=
# Optional one-shot probe. start and policy-valid-until are UTC Unix seconds.
NETWATCH_PROBE_URL=
NETWATCH_PROBE_ENTITY=
NETWATCH_PROBE_COHORT=
NETWATCH_PROBE_START=
NETWATCH_PROBE_POLICY_VALID_UNTIL=
